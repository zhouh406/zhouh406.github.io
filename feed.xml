---
layout: null
permalink: /feed.xml
---
<?xml version="1.0" encoding="utf-8"?>
{% assign feed_notes = site.knowledge | sort: 'date' | reverse %}
<feed xmlns="http://www.w3.org/2005/Atom">
  <title>{{ site.title | xml_escape }}</title>
  <subtitle>{{ site.description | xml_escape }}</subtitle>
  <link href="{{ '/feed.xml' | absolute_url }}" rel="self" type="application/atom+xml"/>
  <link href="{{ '/' | absolute_url }}" rel="alternate" type="text/html"/>
  <updated>{{ feed_notes.first.date | date_to_xmlschema }}</updated>
  <id>{{ '/' | absolute_url }}</id>
  <author>
    <name>{{ site.data.profile.name | xml_escape }}</name>
    <email>{{ site.data.profile.contact.email | xml_escape }}</email>
  </author>
  {% for note in feed_notes limit: 20 %}
  <entry>
    <title>{{ note.title | xml_escape }}</title>
    <link href="{{ note.url | absolute_url }}" rel="alternate" type="text/html"/>
    <id>{{ note.url | absolute_url }}</id>
    <published>{{ note.date | date_to_xmlschema }}</published>
    <updated>{{ note.date | date_to_xmlschema }}</updated>
    <category term="{{ note.category | xml_escape }}"/>
    <summary type="html">{{ note.summary | xml_escape }}</summary>
  </entry>
  {% endfor %}
</feed>
